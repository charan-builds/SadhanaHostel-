NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_SUPABASE_URL=https://REDACTED_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REDACTED_SUPABASE_ANON_KEY
NEXT_PUBLIC_DEFAULT_ORGANIZATION_ID=00000000-0000-4000-8000-000000000000
NEXT_PUBLIC_DEFAULT_HOSTEL_ID=00000000-0000-4000-8000-000000000000
NEXT_PUBLIC_LAUNCH_MODE=local
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_FEATURE_FLAGS=owner_analytics,resident_onboarding,manual_upi_payments,admissions,automation,support_center,staff_access,cms
# Production SEO. Paste the Google Search Console HTML meta verification token only in production.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement ID. Use the live property only for production or intentional GA4 testing.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-39K0JSVGSZ

# Server-only. Never expose this with NEXT_PUBLIC_ and never use it in client components.
SUPABASE_SERVICE_ROLE_KEY=REDACTED_SUPABASE_SERVICE_ROLE_KEY

# Observability
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Explicit opt-in. Keep false locally to avoid slow/hanging source-map uploads.
SENTRY_UPLOAD_SOURCE_MAPS=false

# Runtime hardening defaults.
LOG_LEVEL=info
LAUNCH_MODE=local
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=
MAINTENANCE_BYPASS_TOKEN=REDACTED_OPTIONAL_SECRET
FEATURE_FLAGS=owner_analytics,resident_onboarding,manual_upi_payments,admissions,automation,support_center,staff_access,cms
SOFT_LAUNCH_RESIDENT_LIMIT=20
LAUNCH_SUPPORT_WHATSAPP= 
LAUNCH_OWNER_EMAIL=
RATE_LIMIT_ENABLED=true
CRON_JOBS_ENABLED=true
OPERATIONAL_REPAIRS_ENABLED=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=REDACTED_OPTIONAL_SECRET
STORAGE_SIGNED_URL_TTL_SECONDS=3600
INVITE_TOKEN_SECRET=REDACTED_OPTIONAL_SECRET
NOTIFICATIONS_SEND_ENABLED=false
# Optional Web Push delivery. Required only before enabling live browser push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=REDACTED_OPTIONAL_VAPID_PRIVATE_KEY
VAPID_SUBJECT=
VAPID_CONTACT_EMAIL=
CRON_SECRET=REDACTED_CRON_SECRET

# Resend email delivery. Keep disabled locally unless you intend to send real mail.
RESEND_API_KEY=REDACTED_OPTIONAL_RESEND_API_KEY
EMAIL_FROM="Sadhana Boys Hostel <onboarding@resend.dev>"
EMAIL_REPLY_TO=

# Cashfree will be wired in a later phase.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=REDACTED_OPTIONAL_CASHFREE_SECRET_KEY
CASHFREE_ENV=sandbox

# Optional for integration/security tests. Use a disposable database only.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Disaster recovery evidence and restore drills.
# DATABASE_URL must be the source production/staging Postgres URL used for backup checks.
# SUPABASE_DB_PASSWORD is required by Supabase CLI db dump when using the linked project.
# RESTORE_DATABASE_URL must point to the isolated restored database, never production.
# RESTORE_SUPABASE_URL and RESTORE_SUPABASE_SERVICE_ROLE_KEY must point to the
# isolated restored Supabase Storage API for storage restore validation.
# RECOVERY_APP_URL/DEPLOYMENT_URL must point to the app instance wired to the restored environment.
SUPABASE_PROJECT_REF=REDACTED_PROJECT_REF
SUPABASE_DB_PASSWORD=REDACTED_DATABASE_PASSWORD
DATABASE_URL=postgresql://postgres.REDACTED_PROJECT_REF:REDACTED_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
MIGRATION_VERIFY_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
RESTORE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
RESTORE_SUPABASE_URL=http://127.0.0.1:54321
RESTORE_SUPABASE_SERVICE_ROLE_KEY=REDACTED_RESTORE_SERVICE_ROLE_KEY
RECOVERY_APP_URL=http://localhost:3002
DEPLOYMENT_URL=http://localhost:3002

# Auth E2E QA accounts. Use local/staging only; never seed predictable users in production.
AUTH_TEST_SEED_ENABLED=false
E2E_AUTH_RUN_REAL_FLOWS=false
E2E_ADMIN_EMAIL=admin.qa@example.com
E2E_ADMIN_PASSWORD=
E2E_RESIDENT_EMAIL=resident.qa@example.com
E2E_RESIDENT_PASSWORD=
