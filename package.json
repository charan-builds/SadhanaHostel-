{
  "name": "sadhana-hostel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev/free-next-port.mjs 3002 && next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/tests/unit",
    "test:integration": "vitest run src/tests/integration",
    "test:security": "vitest run src/tests/security",
    "test:smoke": "playwright test",
    "test:coverage": "vitest run --coverage",
    "security:secrets": "node scripts/security/secret-scan.mjs",
    "security:secrets:staged": "node scripts/security/secret-scan.mjs --staged",
    "load:k6": "k6 run scripts/load-testing/sadhana-hostel.load.js",
    "staging:seed": "tsx scripts/staging-seed.ts",
    "ci:bundle-budget": "tsx scripts/ci/bundle-budget.ts",
    "ci:deployment-health": "tsx scripts/ci/deployment-health-check.ts",
    "release:staging:preflight": "tsx scripts/release/staging-preflight.ts",
    "release:soft-launch:validate": "tsx scripts/release/soft-launch-validation.ts",
    "release:production:hardening": "tsx scripts/release/soft-launch-validation.ts --strict",
    "check": "npm run lint && npm run typecheck",
    "recovery:backup-check": "tsx scripts/recovery/backup-check.ts",
    "recovery:migration-verify": "tsx scripts/recovery/migration-verify.ts",
    "recovery:restore-validation": "tsx scripts/recovery/restore-validation.ts",
    "recovery:drill": "tsx scripts/recovery/disaster-recovery-drill.ts",
    "auth:seed-test-users": "tsx scripts/auth/create-auth-test-users.ts",
    "dev:reset-resident-lifecycle": "tsx scripts/dev/reset-resident-lifecycle-test-data.ts",
    "types:supabase": "supabase gen types typescript --linked > src/types/database.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.0",
    "@tanstack/react-query": "^5.100.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "resend": "^6.12.3",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pg": "^8.21.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
