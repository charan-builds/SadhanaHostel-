# Sadhana Boys Hostel Platform - staging environment contract.
# Copy values into Vercel Staging/Preview and the matching Supabase staging project.

NEXT_PUBLIC_APP_URL=https://staging.example.com
NEXT_PUBLIC_SUPABASE_URL=https://REDACTED_STAGING_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REDACTED_STAGING_SUPABASE_ANON_KEY
NEXT_PUBLIC_DEFAULT_ORGANIZATION_ID=00000000-0000-4000-8000-000000000000
NEXT_PUBLIC_DEFAULT_HOSTEL_ID=00000000-0000-4000-8000-000000000000
NEXT_PUBLIC_LAUNCH_MODE=staging
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_FEATURE_FLAGS=owner_analytics,resident_onboarding,manual_upi_payments,admissions,automation,support_center,staff_access,cms
# Keep empty for staging/preview unless you intentionally verify that property.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Keep empty for staging/preview unless you intentionally send staging traffic to GA4.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only. Never expose this with NEXT_PUBLIC_ and never use it in client components.
SUPABASE_SERVICE_ROLE_KEY=REDACTED_STAGING_SUPABASE_SERVICE_ROLE_KEY

# Observability
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_UPLOAD_SOURCE_MAPS=false

# Runtime hardening
LOG_LEVEL=info
LAUNCH_MODE=staging
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=
MAINTENANCE_BYPASS_TOKEN=REDACTED_STAGING_MAINTENANCE_BYPASS_TOKEN
FEATURE_FLAGS=owner_analytics,resident_onboarding,manual_upi_payments,admissions,automation,support_center,staff_access,cms
SOFT_LAUNCH_RESIDENT_LIMIT=20
LAUNCH_SUPPORT_WHATSAPP=
LAUNCH_OWNER_EMAIL=owner-staging@example.com
RATE_LIMIT_ENABLED=true
CRON_JOBS_ENABLED=true
OPERATIONAL_REPAIRS_ENABLED=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=REDACTED_OPTIONAL_UPSTASH_TOKEN
STORAGE_SIGNED_URL_TTL_SECONDS=900
INVITE_TOKEN_SECRET=REDACTED_STAGING_INVITE_TOKEN_SECRET
NOTIFICATIONS_SEND_ENABLED=false
CRON_SECRET=REDACTED_STAGING_CRON_SECRET

# Resend staging delivery. Keep disabled until sender/domain and recipients are verified.
RESEND_API_KEY=REDACTED_OPTIONAL_RESEND_API_KEY
EMAIL_FROM="Sadhana Boys Hostel Staging <onboarding@resend.dev>"
EMAIL_REPLY_TO=ops-staging@example.com

# Cashfree staging must remain sandbox-only.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=REDACTED_OPTIONAL_CASHFREE_SECRET_KEY
CASHFREE_ENV=sandbox

# CI, recovery, and staging seed tooling.
SUPABASE_PROJECT_REF=REDACTED_STAGING_PROJECT_REF
SUPABASE_DB_PASSWORD=REDACTED_STAGING_DATABASE_PASSWORD
DATABASE_URL=postgresql://postgres:REDACTED_PASSWORD@db.REDACTED_PROJECT_REF.supabase.co:5432/postgres
DATABASE_SSL=true
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
MIGRATION_VERIFY_DATABASE_URL=postgresql://postgres:REDACTED_PASSWORD@127.0.0.1:54322/postgres
RESTORE_DATABASE_URL=postgresql://postgres:REDACTED_PASSWORD@127.0.0.1:54323/postgres
RESTORE_SUPABASE_URL=https://restored-staging-project.supabase.co
RESTORE_SUPABASE_SERVICE_ROLE_KEY=REDACTED_RESTORE_SERVICE_ROLE_KEY
STAGING_SEED_ORGANIZATION_ID=00000000-0000-4000-8000-000000000000
STAGING_SEED_HOSTEL_ID=00000000-0000-4000-8000-000000000000
STAGING_SEED_RESIDENT_COUNT=120
STAGING_SEED_ROOM_COUNT=36

# Load testing. Use synthetic staging users only.
LOAD_TEST_BASE_URL=https://staging.example.com
LOAD_TEST_ORGANIZATION_ID=00000000-0000-4000-8000-000000000000
LOAD_TEST_HOSTEL_ID=00000000-0000-4000-8000-000000000000
LOAD_TEST_RESIDENT_ID=00000000-0000-4000-8000-000000000000
LOAD_TEST_ADMIN_EMAIL=admin.staging@example.com
LOAD_TEST_ADMIN_PASSWORD=REDACTED_STAGING_PASSWORD
LOAD_TEST_RESIDENT_EMAIL=resident.staging@example.com
LOAD_TEST_RESIDENT_PASSWORD=REDACTED_STAGING_PASSWORD

# Auth E2E QA accounts. Staging-only values; do not reuse production credentials.
AUTH_TEST_SEED_ENABLED=false
E2E_AUTH_RUN_REAL_FLOWS=false
E2E_ADMIN_EMAIL=admin.qa.staging@example.com
E2E_ADMIN_PASSWORD=
E2E_RESIDENT_EMAIL=resident.qa.staging@example.com
E2E_RESIDENT_PASSWORD=
